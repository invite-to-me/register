{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/invite-to-me/register/blob/main/schema.json",
  "title": "invite-to.me domain",
  "description": "one name on invite-to.me. the file name is the name: domains/<name>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner"],
  "properties": {
    "$schema": { "type": "string" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "description": "your github username, must match the pr author",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}$"
        },
        "discord": { "type": "string", "description": "optional, so we can reach you" },
        "email": { "type": "string", "description": "optional, so we can reach you" }
      }
    },
    "description": { "type": "string", "maxLength": 200 },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["bot", "server", "url"],
          "description": "bot: client id or authorize link. server: invite code or discord.gg link. url: any https link"
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "content"],
        "properties": {
          "type": { "enum": ["CNAME", "A", "AAAA", "TXT"] },
          "host": {
            "type": "string",
            "default": "@",
            "description": "@ for the name itself, or one label like www or _discord",
            "pattern": "^(@|_?[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)$"
          },
          "content": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "proxied": { "type": "boolean", "default": false, "description": "a, aaaa and cname only" }
        }
      }
    }
  },
  "oneOf": [{ "required": ["redirect"] }, { "required": ["records"] }]
}
